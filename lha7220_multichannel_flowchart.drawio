<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Page-1" id="lha7220-multichannel">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="4" value="&lt;div style=&quot;font-size:16px;font-weight:bold;color:#1a365d;&quot;&gt;LHA7220 双通道差分轮询采集执行流程图 (Single-Shot 模式)&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#4a5568;margin-top:4px;&quot;&gt;硬件验证: 写CONFIG0自动触发单次转换 | 转换期保持CS为低 | DOUT/DRDY下降沿就绪 | 24+8 SCLK读数复位&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="940" height="65" as="geometry" />
        </mxCell>

        <!-- Swimlane 1: Main Polling Process -->
        <mxCell id="2" value="主程序轮询调度流程 (Main / Polling Flow)" style="swimlane;startSize=32;fillColor=#f7fafc;strokeColor=#4a5568;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#2d3748;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="730" as="geometry" />
        </mxCell>

        <!-- Main: Start -->
        <mxCell id="10" value="系统上电 / 启动" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#38a169;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#22543d;" vertex="1" parent="2">
          <mxGeometry x="120" y="50" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- Main: Init -->
        <mxCell id="11" value="&lt;b&gt;初始化 example_multichannel_init()&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• 软件复位芯片: lha7220_SoftwareReset()&lt;br/&gt;• CONFIG1 = 0x00: 20 SPS, 单次模式 (CM=0)&lt;br/&gt;• CONFIG2 = 0x00: 内部基准 2.048V, IDAC 关闭&lt;br/&gt;• CONFIG3 = 0x02: &lt;b&gt;使能 DRDYM=1 (DOUT/DRDY 脉冲)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ebf8ff;strokeColor=#3182ce;strokeWidth=1.5;fontSize=11;fontColor=#2b6cb0;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="2">
          <mxGeometry x="30" y="115" width="320" height="110" as="geometry" />
        </mxCell>

        <!-- Main: Loop Marker -->
        <mxCell id="12" value="进入主循环 example_multichannel_loop()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#744210;" vertex="1" parent="2">
          <mxGeometry x="70" y="250" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- Main: Channel 1 Sampling -->
        <mxCell id="13" value="&lt;b&gt;采集通道 1 (CH1: AIN0 - AIN1)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• 调用: sample_single_channel(&quot;CH1&quot;, 0x06, &amp;amp;ch1_mv)&lt;br/&gt;• 写入字: 0x06 (MUX=AIN0-AIN1, Gain=8)&lt;br/&gt;• 满量程范围: ±256.0 mV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;fontSize=11;fontColor=#2c5282;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="2">
          <mxGeometry x="30" y="315" width="320" height="80" as="geometry" />
        </mxCell>

        <!-- Main: Channel 2 Sampling -->
        <mxCell id="14" value="&lt;b&gt;采集通道 2 (CH2: AIN2 - AIN3)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• 调用: sample_single_channel(&quot;CH2&quot;, 0x56, &amp;amp;ch2_mv)&lt;br/&gt;• 写入字: 0x56 (MUX=AIN2-AIN3, Gain=8)&lt;br/&gt;• 满量程范围: ±256.0 mV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;fontSize=11;fontColor=#2c5282;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="2">
          <mxGeometry x="30" y="420" width="320" height="80" as="geometry" />
        </mxCell>

        <!-- Main: Delay -->
        <mxCell id="15" value="&lt;b&gt;延时等待: delay_ms(800)&lt;/b&gt;&lt;br/&gt;保持轮询采集周期，便于上位机/串口监视" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#edf2f7;strokeColor=#718096;strokeWidth=1.5;fontSize=11;fontColor=#2d3748;" vertex="1" parent="2">
          <mxGeometry x="70" y="525" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Main Edges -->
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38a169;strokeWidth=1.5;" edge="1" parent="2" source="10" target="11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182ce;strokeWidth=1.5;" edge="1" parent="2" source="11" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d69e2e;strokeWidth=1.5;" edge="1" parent="2" source="12" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182ce;strokeWidth=1.5;" edge="1" parent="2" source="13" target="14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182ce;strokeWidth=1.5;" edge="1" parent="2" source="14" target="15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25" value="循环下一轮" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#718096;strokeWidth=1.5;fontSize=10;fontColor=#4a5568;" edge="1" parent="2" source="15" target="12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="15" y="550" />
              <mxPoint x="15" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Swimlane 2: Single Channel Timing Flow -->
        <mxCell id="3" value="单通道核心采集时序 (sample_single_channel)" style="swimlane;startSize=32;fillColor=#f7fafc;strokeColor=#4a5568;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#2d3748;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="480" height="730" as="geometry" />
        </mxCell>

        <!-- Sub: Entry -->
        <mxCell id="30" value="子流程入口: (channel_name, config0_val)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e9d8fd;strokeColor=#805ad5;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#44337a;" vertex="1" parent="3">
          <mxGeometry x="110" y="50" width="260" height="40" as="geometry" />
        </mxCell>

        <!-- Sub: Step 1 -->
        <mxCell id="31" value="&lt;b&gt;【步骤 1】写入 CONFIG0 自动触发单次转换&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• CSN_LOW: 拉低片选 CS&lt;br/&gt;• SPI 发送 WREG 命令及配置字 (MUX + Gain)&lt;br/&gt;• &lt;b&gt;【核心时序】转换期间必须持续保持 CS 为低电平！&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;(若拉高 CS，DOUT/DRDY 进入高阻态，无法输出就绪脉冲)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#feebc8;strokeColor=#dd6b20;strokeWidth=1.5;fontSize=11;fontColor=#7b341e;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="3">
          <mxGeometry x="30" y="115" width="420" height="90" as="geometry" />
        </mxCell>

        <!-- Sub: Step 2 -->
        <mxCell id="32" value="&lt;b&gt;【步骤 2】轮询等待 DOUT/DRDY 下降沿 (PA6/IDR)&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• 阶段 1: 等待 DOUT/DRDY 变高 (进入转换状态，限时 15ms)&lt;br/&gt;• 阶段 2: 等待 DOUT/DRDY 从高电平跳变到低电平 (下降沿 = 转换就绪)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;fontSize=11;fontColor=#2c5282;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="3">
          <mxGeometry x="30" y="230" width="420" height="80" as="geometry" />
        </mxCell>

        <!-- Sub: Judge -->
        <mxCell id="33" value="是否在 100ms 内&lt;br/&gt;捕获下降沿？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#d69e2e;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#744210;" vertex="1" parent="3">
          <mxGeometry x="140" y="335" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Sub: Step 3 (Left: Success Path) -->
        <mxCell id="34" value="&lt;b&gt;【步骤 3】24+8 SCLK 读数据与引脚复位&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• 前 24 SCLK: 读出 3 字节 ADC 原始采样码值&lt;br/&gt;• &lt;b&gt;后 8 SCLK (Dummy): 强制芯片将 DOUT 拉高复位&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;(严格遵守手册 9.5.6 节 Figure 38 时序要求)&lt;br/&gt;• CSN_HIGH: 拉高 CS，释放 SPI 总线" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#bee3f8;strokeColor=#3182ce;strokeWidth=1.5;fontSize=11;fontColor=#2c5282;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="3">
          <mxGeometry x="30" y="430" width="270" height="95" as="geometry" />
        </mxCell>

        <!-- Sub: Step 4 (Left: Voltage Calc) -->
        <mxCell id="36" value="&lt;b&gt;【步骤 4】电压转换与串口格式化打印&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• lha7220_CodeToVoltage(raw_code, 2048mV, Gain=8)&lt;br/&gt;• printf 输出通道名、Hex 码值、补码及实际 mV 电压" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#c6f6d5;strokeColor=#38a169;strokeWidth=1.5;fontSize=11;fontColor=#22543d;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="3">
          <mxGeometry x="30" y="550" width="270" height="75" as="geometry" />
        </mxCell>

        <!-- Sub: Timeout Error (Right: Failure Path) -->
        <mxCell id="35" value="&lt;b&gt;超时保护&lt;/b&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;• CSN_HIGH (拉高)&lt;br/&gt;• 串口打印错误&lt;br/&gt;• 返回 0 (失败)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fed7d7;strokeColor=#e53e3e;strokeWidth=1.5;fontSize=11;fontColor=#742a2a;align=center;" vertex="1" parent="3">
          <mxGeometry x="330" y="450" width="120" height="85" as="geometry" />
        </mxCell>

        <!-- Sub: Return -->
        <mxCell id="37" value="子流程结束 (返回 1 或 0)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#805ad5;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#44337a;" vertex="1" parent="3">
          <mxGeometry x="130" y="655" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Sub Edges -->
        <mxCell id="40" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#805ad5;strokeWidth=1.5;" edge="1" parent="3" source="30" target="31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="41" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dd6b20;strokeWidth=1.5;" edge="1" parent="3" source="31" target="32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="42" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182ce;strokeWidth=1.5;" edge="1" parent="3" source="32" target="33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="43" value="是 (数据就绪)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#38a169;strokeWidth=1.5;fontSize=10;fontColor=#22543d;" edge="1" parent="3" source="33" target="34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="44" value="否 (超时)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#e53e3e;strokeWidth=1.5;fontSize=10;fontColor=#742a2a;" edge="1" parent="3" source="33" target="35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182ce;strokeWidth=1.5;" edge="1" parent="3" source="34" target="36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="46" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#38a169;strokeWidth=1.5;" edge="1" parent="3" source="36" target="37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Route error edge down right corridor and enter right side of return oval -->
        <mxCell id="47" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#e53e3e;strokeWidth=1.5;" edge="1" parent="3" source="35" target="37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross-Container Calling Edges -->
        <mxCell id="50" value="① 调用采样 CH1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;dashed=1;strokeColor=#3182ce;strokeWidth=1.8;fontSize=11;fontColor=#2b6cb0;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="13" target="30">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="445" y="455" />
              <mxPoint x="445" y="164" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="51" value="② 调用采样 CH2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;dashed=1;strokeColor=#805ad5;strokeWidth=1.8;fontSize=11;fontColor=#553c9a;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="14" target="30">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="560" />
              <mxPoint x="470" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Bottom Legend & Summary Box -->
        <mxCell id="5" value="&lt;b&gt;【硬件验证关键设计要点总结】&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;引脚复用与电平检测:&lt;/b&gt; PA6 (SPI1_MISO) 复用为 DOUT/DRDY，AF5 模式下内部输入缓冲器始终使能，直接读 GPIOA-&amp;gt;IDR 即可捕获下降沿，无需切换引脚方向。&lt;br/&gt;2. &lt;b&gt;CS 片选保持规则:&lt;/b&gt; 写 CONFIG0 触发单次转换后，&lt;b&gt;必须保持 CS 为低电平&lt;/b&gt;；若拉高 CS，引脚进入 Hi-Z 态，无法检测到就绪跳变。&lt;br/&gt;3. &lt;b&gt;时序规范 Figure 38:&lt;/b&gt; 读完 24 位数据后附加 8 个 SCLK (Dummy 字节)，强制芯片内部拉高 DOUT，避免电平未释放导致下次误判。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f7fafc;strokeColor=#cbd5e0;strokeWidth=1;fontSize=11;fontColor=#4a5568;align=left;spacingLeft=15;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="845" width="940" height="85" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>